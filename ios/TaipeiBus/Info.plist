<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>一路</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleDevelopmentRegion</key><string>zh-Hant</string>
  <key>CFBundleLocalizations</key><array><string>zh-Hant</string><string>en</string></array>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
  <key>NSLocationWhenInUseUsageDescription</key><string>從目前位置規劃公車行程，尋找附近上車站牌與步行路線；導航進行中也會在背景更新下車提醒與即時動態。</string>
  <key>NSMicrophoneUsageDescription</key><string>按下麥克風說出要去哪裡時使用；聲音只用來轉成文字，不儲存或上傳。</string>
  <key>BusAssistantURL</key><string></string>
  <key>BusAssistantKey</key><string></string>
  <key>NSSpeechRecognitionUsageDescription</key><string>把你說的行程轉成文字並規劃路線；支援時在手機上辨識，不儲存錄音。</string>
  <key>NSCameraUsageDescription</key><string>在手機上辨識公車車牌，協助你從同路線附近的車輛中確認搭乘車輛。影像不儲存、不上傳。</string>
  <key>NSLocationTemporaryUsageDescriptionDictionary</key><dict>
    <key>Navigation</key><string>導航時需要精確位置，才能跟著步行路線提示轉彎、計算剩餘距離，並在下車前提醒你。</string>
  </dict>
  <key>CADisableMinimumFrameDurationOnPhone</key><true/>
  <key>NSSupportsLiveActivities</key><true/>
  <key>UIBackgroundModes</key><array><string>audio</string><string>location</string></array>
  <key>BusSharedKeychainGroup</key><string>$(AppIdentifierPrefix)$(BUS_APP_BUNDLE_ID).shared</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>$(BUS_APP_BUNDLE_ID)</string>
    <key>CFBundleURLSchemes</key><array><string>taipeibus</string></array>
  </dict></array>
</dict></plist>
