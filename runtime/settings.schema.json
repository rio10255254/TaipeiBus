{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "copy": {
      "type": "object",
      "maxProperties": 150,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "search": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "names": {
                "type": "array",
                "minItems": 2,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "queries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "names",
              "queries"
            ]
          }
        },
        "debounceMilliseconds": {
          "type": "integer",
          "minimum": 80,
          "maximum": 500
        },
        "resultLimit": {
          "type": "integer",
          "minimum": 6,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "walkingColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "waterColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "parkColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "buildingColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "textScale": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1.2
        },
        "spacingScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3
        },
        "cornerScale": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.3
        },
        "solidSurfaces": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "firstWalkMeters": {
          "type": "number",
          "minimum": 300,
          "maximum": 1000
        },
        "expandedWalkMeters": {
          "type": "number",
          "minimum": 300,
          "maximum": 1200
        },
        "walkingOnlyMeters": {
          "type": "number",
          "minimum": 300,
          "maximum": 1000
        },
        "walkingWeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "waitingWeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "transferPenaltySeconds": {
          "type": "number",
          "minimum": 180,
          "maximum": 900
        }
      },
      "additionalProperties": false
    },
    "refresh": {
      "type": "object",
      "properties": {
        "vehicleSeconds": {
          "type": "number",
          "minimum": 10,
          "maximum": 30
        },
        "metadataHours": {
          "type": "number",
          "minimum": 6,
          "maximum": 24
        },
        "settingsSeconds": {
          "type": "number",
          "minimum": 60,
          "maximum": 900
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "nearbyStops": {
          "type": "boolean"
        },
        "quickDestinations": {
          "type": "boolean"
        },
        "stationShortcut": {
          "type": "boolean"
        },
        "routeShortcut": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "quickDestinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "minimumAppVersion"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaipeiBus live content schema 1"
}
